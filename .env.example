# 複製這個檔案成 .env.local，填好後重新啟動系統

# 道館名稱（網頁、LINE 訊息、報名頁都會顯示）
APP_NAME=跆拳道館
# 系統登入密碼（Mac、iPad 第一次打開時輸入）
APP_PASSWORD=請改成你的密碼

# 網頁和 LINE Webhook 的埠號（同一台電腦跑兩套系統時才需要改）
APP_PORT=3000
LINE_WEBHOOK_PORT=3001

# LINE 官方帳號（LINE Developers → Messaging API）
LINE_BASIC_ID=@你的官方帳號ID
LINE_CHANNEL_SECRET=請填入
# 二選一：長期 access token，或填 LINE_CHANNEL_ID 讓系統自動換 30 天的 token
LINE_CHANNEL_ACCESS_TOKEN=請填入
# LINE_CHANNEL_ID=
# 館長的 LINE userId；留空的話，在官方帳號傳「館長 系統密碼」就會自動設定
LINE_USER_ID=

# 不需要的功能（用逗號分開）：fees 收費、trials 體驗預約、coach 教練打卡、makeup 補課、contests 比賽報名、signup 新生報名、exams 晉級考試
APP_HIDE=
